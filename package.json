{
  "name": "@jungvonmatt/contentful-ssg-project",
  "version": "1.0.0",
  "private": true,
  "description": "A monorepo for all NPM packages related to contentful-ssg",
  "license": "MIT",
  "author": "Jung von Matt TECH GmbH",
  "repository": {
    "type": "git",
    "url": "https://github.com/jungvonmatt/contentful-ssg"
  },
  "type": "module",
  "scripts": {
    "clean": "turbo run clean",
    "commit": "cz",
    "prerelease": "pnpm run test:ci",
    "release": "lerna version --no-private --conventional-commits --create-release github --yes && lerna publish from-git --yes",
    "compile": "turbo run compile",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "turbo run lint && vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/publish": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "check-dependency-version-consistency": "catalog:",
    "git-cz": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "supertest": "catalog:",
    "ts-node": "catalog:",
    "turbo": "catalog:",
    "typescript": "^5.8.3",
    "vitest": "catalog:",
    "vitest-sonar-reporter": "catalog:"
  },
  "lint-staged": {
    "packages/**/*.{ts,js,cjs,mjs}": [
      "oxfmt"
    ],
    "packages/**/{src,test}/**/*.ts": [
      "oxlint --fix"
    ]
  },
  "config": {
    "validate-commit-msg": {
      "types": "conventional-commit-types",
      "helpMessage": "Use \"pnpm run commit\" instead, we use conventional-changelog format :) (https://github.com/commitizen/cz-cli)"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.1.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0"
    }
  }
}
