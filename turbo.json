{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "compile": {
      "dependsOn": [
        "^compile"
      ],
      "outputs": [
        "dist/**"
      ],
      "inputs": [
        "src/*.ts",
        "src/**/*.ts"
      ]
    },
    "test": {
      "dependsOn": [
        "^compile"
      ],
      "inputs": [
        "src/*.ts",
        "src/**/*.ts",
        "**/*.js",
        "test/**/*.ts",
        "test/**/*.js"
      ]
    },
    "lint": {
      "dependsOn": [
        "compile",
        "^compile"
      ],
      "inputs": [
        "src/*.ts",
        "src/**/*.ts",
        "**/*.js",
        "test/**/*.ts",
        "test/**/*.js",
        "../../.oxlintrc.json"
      ],
      "outputs": []
    },
    "watch": {
      "cache": false
    }
  }
}